    async function pushSpoolsToGithub() {
      const owner = document.getElementById('ghOwner').value.trim() || localStorage.getItem('fh_gh_owner');
      const repo = document.getElementById('ghRepo').value.trim() || localStorage.getItem('fh_gh_repo');
      const token = document.getElementById('ghToken').value.trim() || localStorage.getItem('fh_gh_token');
      if (!owner || !repo || !token) {
        showToast('Bitte erst GitHub Nutzername, Repo und Token eintragen.');
        return;
      }
      try {
        const apiUrl = `https://api.github.com/repos/${owner}/${repo}/contents/spools.json`;
        let sha = undefined;
        const getRes = await fetch(apiUrl, { headers: { 'Authorization': `Bearer ${token}` } });
        if (getRes.ok) {
          const existing = await getRes.json();
          sha = existing.sha;
        }
        const contentB64 = btoa(unescape(encodeURIComponent(JSON.stringify({ updatedAt: new Date().toISOString(), spools, printHistory }, null, 2))));
        const putRes = await fetch(apiUrl, {
          method: 'PUT',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ message: `FilamentHub Update v1.21 (${spools.length} Spulen)`, content: contentB64, sha })
        });
        if (putRes.ok) showToast('✅ Erfolgreich als spools.json in dein GitHub gepusht!');
        else showToast('⚠️ GitHub-Push fehlgeschlagen (Token/Repo prüfen).');
      } catch (e) {
        showToast('⚠️ Netzwerkfehler beim GitHub-Push.');
      }
    }

    // =========================================================================
    // 7. RÜCKGÄNGIG / VORWÄRTS (UNDO / REDO) & QR-CODE KOPPLUNG
    // =========================================================================
    const MAX_UNDO_STEPS = 50;
    let undoStack = [];
    let redoStack = [];

    function snapshotState() {
      return JSON.stringify({ spools, printHistory });
    }

    function pushUndo() {
      undoStack.push(snapshotState());
      if (undoStack.length > MAX_UNDO_STEPS) undoStack.shift();
      redoStack = [];
      updateUndoRedoButtons();
    }

    function restoreSnapshot(json) {
      const data = JSON.parse(json);
      spools = Array.isArray(data.spools) ? data.spools : [];
      printHistory = Array.isArray(data.printHistory) ? data.printHistory : [];
      saveState();
      updateUndoRedoButtons();
    }

    function undoAction() {
      if (!undoStack.length) return;
      redoStack.push(snapshotState());
      restoreSnapshot(undoStack.pop());
      showToast('Rückgängig gemacht.');
    }

    function redoAction() {
      if (!redoStack.length) return;
      undoStack.push(snapshotState());
      restoreSnapshot(redoStack.pop());
      showToast('Wiederhergestellt (vorwärts).');
    }

    function updateUndoRedoButtons() {
      const u = document.getElementById('undoBtn');
      const r = document.getElementById('redoBtn');
      if (u) { u.disabled = !undoStack.length; u.title = `Rückgängig (Strg+Z) – ${undoStack.length} Schritt(e)`; }
      if (r) { r.disabled = !redoStack.length; r.title = `Vorwärts (Strg+Y) – ${redoStack.length} Schritt(e)`; }
    }

    // Tastenkürzel: ESC schließt Menü & Modals, Strg+Z / Strg+Y für Undo/Redo
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeSideMenu();
        closeSpoolModal();
        closeQrModal();
        closeHistoryModal();
      }
      const tag = e.target && e.target.tagName;
      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'z' && !e.shiftKey) {
        e.preventDefault();
        undoAction();
      } else if ((e.ctrlKey || e.metaKey) && (e.key.toLowerCase() === 'y' || (e.shiftKey && e.key.toLowerCase() === 'z'))) {
        e.preventDefault();
        redoAction();
      }
    });

