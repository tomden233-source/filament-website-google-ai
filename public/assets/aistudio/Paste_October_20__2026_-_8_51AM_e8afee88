    function saveGithubConfig() {
      localStorage.setItem('fh_gh_owner', document.getElementById('ghOwner').value.trim());
      localStorage.setItem('fh_gh_repo', document.getElementById('ghRepo').value.trim());
      localStorage.setItem('fh_gh_token', document.getElementById('ghToken').value.trim());
