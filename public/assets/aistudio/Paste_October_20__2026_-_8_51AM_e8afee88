  <!-- MODAL: QR-CODE & HANDY-KOPPLUNG                                           -->
  <!-- ========================================================================= -->
  <div id="qrModal" onclick="if(event.target === this) closeQrModal()" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/80 backdrop-blur-sm p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-sm w-full p-5 space-y-3 shadow-2xl">
      <div class="flex justify-between items-start border-b border-slate-800 pb-2.5">
        <div>
          <h3 class="text-base font-bold text-white">📱 Handy & PC Live-Kopplung</h3>
          <p class="text-[11px] text-slate-400">QR-Code scannen – verbindet dein Handy sofort mit deiner Cloud</p>
        </div>
        <button onclick="closeQrModal()" class="text-slate-400 hover:text-white">✕</button>
      </div>
      <div class="flex justify-center">
        <div class="p-3 rounded-xl bg-white">
          <div id="qrCanvas" class="w-[220px] h-[220px] flex items-center justify-center text-center text-xs text-slate-700"></div>
        </div>
