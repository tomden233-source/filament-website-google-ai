<!DOCTYPE html>
<html lang="de" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FilamentHub v1.21 – 3D-Druck Filament-Manager</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            slate: { 850: '#162032', 925: '#0b111e' }
          }
        }
      }
    };
  </script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap');
    body { font-family: 'Inter', sans-serif; background-color: #0b111e; color: #f1f5f9; }
    .font-mono-num { font-family: 'JetBrains Mono', monospace; }
    @keyframes pulse-border {
      0%, 100% { border-color: rgba(244, 63, 94, 0.85); box-shadow: 0 0 0 0 rgba(244, 63, 94, 0.25); }
      50% { border-color: rgba(244, 63, 94, 0.3); box-shadow: 0 0 18px 2px rgba(244, 63, 94, 0.2); }
    }
    .overdue-card { animation: pulse-border 2.2s infinite; }
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #0b111e; }
    ::-webkit-scrollbar-thumb { background: #334155; border-radius: 9999px; }
    ::-webkit-scrollbar-thumb:hover { background: #f97316; }
  </style>
</head>
<body class="min-h-screen flex flex-col selection:bg-orange-500 selection:text-white">

  <!-- ========================================================================= -->
  <!-- SEITENMENÜ (LINKS) + KLICKBARE RECHTE FLÄCHE ZUM SOFORTIGEN SCHLIESSEN    -->
  <!-- ========================================================================= -->
  <div id="sideMenuWrapper" class="fixed inset-0 z-50 hidden">
    <!-- Rechte / hintere Fläche: Klick darauf schließt das Menü sofort -->
    <div
      id="sideMenuBackdrop"
      onclick="closeSideMenu()"
      class="fixed inset-0 bg-slate-950/75 backdrop-blur-sm transition-opacity cursor-pointer"
      title="Klick auf die rechte Fläche schließt das Menü"
    ></div>

    <!-- Menü-Drawer links -->
    <aside
      onclick="event.stopPropagation()"
      class="relative z-10 w-[420px] max-w-[88vw] bg-slate-900 border-r border-slate-800 h-full flex flex-col justify-between shadow-2xl overflow-hidden"
    >
      <!-- Drawer Header -->
      <div class="p-4 border-b border-slate-800 flex items-center justify-between bg-slate-950/60">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-orange-500 to-amber-600 flex items-center justify-center shadow-lg shadow-orange-500/20">
            <i data-lucide="disc-3" class="w-5 h-5 text-white"></i>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="font-extrabold text-white text-sm">FilamentHub Studio</span>
              <span class="text-[10px] font-mono-num font-bold px-2 py-0.5 rounded-full bg-orange-500/15 text-orange-400 border border-orange-500/30">v1.21</span>
            </div>
            <p class="text-[11px] text-slate-400">Klick rechts außerhalb schließt das Menü</p>
          </div>
        </div>
        <button onclick="closeSideMenu()" class="p-2 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition" title="Menü schließen">✕</button>
      </div>

      <!-- Umschalter: Vollständige vs. Vereinfachte Variante -->
      <div class="px-4 py-3 bg-slate-900 border-b border-slate-800 space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Ansichts-Variante</span>
          <span id="menuModeHint" class="text-[11px] font-semibold text-orange-400">Vollständig (mit Trocknungsbalken)</span>
        </div>
        <div class="grid grid-cols-2 gap-1.5 p-1 rounded-xl bg-slate-950 border border-slate-800">
          <button id="menuBtnFull" onclick="setViewMode('full')" class="px-3 py-2 rounded-lg text-xs font-bold transition flex items-center justify-center gap-1.5">
            <i data-lucide="layout-grid" class="w-3.5 h-3.5"></i>
            <span>Vollständig</span>
          </button>
          <button id="menuBtnSimple" onclick="setViewMode('simple')" class="px-3 py-2 rounded-lg text-xs font-bold transition flex items-center justify-center gap-1.5">
            <i data-lucide="rows-3" class="w-3.5 h-3.5"></i>
            <span>Vereinfacht</span>
          </button>
        </div>
      </div>

      <!-- Reiter-Navigation im Seitenmenü (KI-Agent, G-Code, Kostenrechner, Shops & Tools) -->
      <div class="grid grid-cols-4 gap-1 p-2 bg-slate-950 border-b border-slate-800 text-[11px] font-bold">
        <button id="tabBtn-ai" onclick="switchSidebarTab('ai')" class="py-2 px-1 rounded-lg bg-orange-500 text-white flex flex-col items-center gap-1 transition">
          <i data-lucide="bot" class="w-4 h-4"></i>
          <span>KI-Agent</span>
        </button>
        <button id="tabBtn-gcode" onclick="switchSidebarTab('gcode')" class="py-2 px-1 rounded-lg text-slate-400 hover:text-white flex flex-col items-center gap-1 transition">
          <i data-lucide="file-code-2" class="w-4 h-4"></i>
          <span>G-Code</span>
        </button>
        <button id="tabBtn-calc" onclick="switchSidebarTab('calc')" class="py-2 px-1 rounded-lg text-slate-400 hover:text-white flex flex-col items-center gap-1 transition">
          <i data-lucide="calculator" class="w-4 h-4"></i>
          <span>Rechner</span>
        </button>
        <button id="tabBtn-tools" onclick="switchSidebarTab('tools')" class="py-2 px-1 rounded-lg text-slate-400 hover:text-white flex flex-col items-center gap-1 transition">
          <i data-lucide="wrench" class="w-4 h-4"></i>
          <span>Tools & Sync</span>
        </button>
      </div>

      <!-- TAB-INHALTE (SCROLLBAR) -->
      <div class="flex-1 overflow-y-auto p-4 space-y-4">

        <!-- TAB 1: KI-AGENT & GITHUB-PUSH -->
        <div id="sidebarTab-ai" class="space-y-3">
          <div class="rounded-xl bg-slate-950 border border-orange-500/30 p-3 space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-orange-400 flex items-center gap-1.5">
                <i data-lucide="sparkles" class="w-4 h-4"></i>
                <span>FilamentHub KI-Assistent</span>
              </span>
              <span class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400 font-semibold">Aktiv</span>
            </div>
            <p class="text-[11px] text-slate-400 leading-relaxed">
              Schreibe Befehle wie: <em class="text-slate-200">„Zieh 65g von Bambu Dunkelgrün ab“</em>, <em class="text-slate-200">„Trag SUNLU PETG Schwarz 1000g ein“</em>, <em class="text-slate-200">„Markiere Eryone als getrocknet“</em> oder <em class="text-slate-200">„Vereinfachte Ansicht“</em>.
            </p>
          </div>

          <div id="aiChatMessages" class="space-y-2 max-h-64 overflow-y-auto pr-1">
            <div class="p-3 rounded-xl bg-slate-800/80 border border-slate-700 text-xs text-slate-200">
              👋 Hallo! Ich kenne alle deine <strong>21 Spulen</strong>. Sag mir einfach, was ich abziehen, eintragen, trocknen oder berechnen soll!
            </div>
          </div>

          <div class="flex gap-2">
            <input
              id="aiPromptInput"
              type="text"
              placeholder="Befehl an KI-Agent eingeben..."
              onkeydown="if(event.key==='Enter'){handleAiPrompt();}"
              class="flex-1 px-3 py-2 rounded-xl bg-slate-950 border border-slate-700 focus:border-orange-500 text-xs text-white outline-none"
            />
            <button onclick="handleAiPrompt()" class="px-3.5 py-2 rounded-xl bg-orange-500 hover:bg-orange-600 text-white text-xs font-bold transition">
              Senden
            </button>
          </div>

          <!-- Schnell-Prompts -->
          <div class="flex flex-wrap gap-1.5 pt-1">
            <button onclick="runQuickPrompt('Welche Spulen müssen dringend getrocknet werden?')" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-[11px] text-slate-300">🔥 Trocknungs-Check</button>
            <button onclick="runQuickPrompt('Zeige mir meinen gesamten Bestand und Wert')" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-[11px] text-slate-300">📊 Bestands-Report</button>
            <button onclick="runQuickPrompt('Markiere alle Eryone Spulen als getrocknet')" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-[11px] text-slate-300">✨ Eryone getrocknet</button>
          </div>

          <!-- GitHub Direkt-Integration -->
          <details class="rounded-xl bg-slate-950 border border-slate-800 p-3 text-xs">
            <summary class="font-bold text-slate-300 cursor-pointer flex items-center justify-between">
              <span>🔗 GitHub Direkt-Schreibzugriff (Optional)</span>
              <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400"></i>
            </summary>
            <div class="mt-3 space-y-2">
              <p class="text-[11px] text-slate-400">Hinterlege optional deinen GitHub-Token, damit der KI-Agent deinen Bestand direkt als <code>spools.json</code> in dein GitHub-Repo committen kann.</p>
              <input id="ghOwner" type="text" placeholder="GitHub Nutzername (z.B. maxmustermann)" class="w-full px-2.5 py-1.5 rounded-lg bg-slate-900 border border-slate-700 text-xs text-white outline-none" />
              <input id="ghRepo" type="text" placeholder="Repository Name (z.B. filamenthub)" class="w-full px-2.5 py-1.5 rounded-lg bg-slate-900 border border-slate-700 text-xs text-white outline-none" />
              <input id="ghToken" type="password" placeholder="GitHub Personal Access Token (ghp_...)" class="w-full px-2.5 py-1.5 rounded-lg bg-slate-900 border border-slate-700 text-xs text-white outline-none" />
              <div class="flex gap-2">
                <button onclick="saveGithubConfig()" class="flex-1 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold">Speichern</button>
                <button onclick="pushSpoolsToGithub()" class="flex-1 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-bold">Jetzt in Git pushen</button>
              </div>
            </div>
          </details>
        </div>

        <!-- TAB 2: G-CODE UPLOAD & 1-KLICK SPULEN-ABZUG -->
        <div id="sidebarTab-gcode" class="space-y-3 hidden">
          <div class="rounded-xl bg-slate-950 border border-sky-500/30 p-3.5 space-y-2">
            <div class="flex items-center gap-2 text-sky-400 text-xs font-bold uppercase">
              <i data-lucide="file-up" class="w-4 h-4"></i>
              <span>G-Code Analysator & Direkt-Abzug</span>
            </div>
            <p class="text-[11px] text-slate-400 leading-relaxed">
              Lade eine <code>.gcode</code>-Datei (Bambu Studio, OrcaSlicer, PrusaSlicer, Cura) hoch. Das Gewicht wird automatisch erkannt – danach einfach unten auf deine Spule klicken, um es sofort abzuziehen!
            </p>
            <label class="mt-2 flex flex-col items-center justify-center border-2 border-dashed border-slate-700 hover:border-sky-400 rounded-xl p-4 cursor-pointer bg-slate-900/60 transition text-center">
              <i data-lucide="upload-cloud" class="w-6 h-6 text-sky-400 mb-1"></i>
              <span class="text-xs font-bold text-white">G-Code Datei auswählen</span>
              <span class="text-[10px] text-slate-400">.gcode / .gco / .txt aus Slicer</span>
              <input id="gcodeFileInput" type="file" accept=".gcode,.gco,.txt,.bgcode" onchange="handleGcodeUpload(event)" class="hidden" />
            </label>
          </div>

          <!-- Ergebnis der G-Code Analyse -->
          <div id="gcodeResultBox" class="hidden rounded-xl bg-slate-950 border border-emerald-500/40 p-3.5 space-y-3">
            <div class="flex items-center justify-between border-b border-slate-800 pb-2">
              <span id="gcodeFileName" class="text-xs font-bold text-white truncate">model.gcode</span>
              <span class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 font-bold">Erkannt</span>
            </div>
            <div class="grid grid-cols-3 gap-2 text-center">
              <div class="p-2 rounded-lg bg-slate-900 border border-slate-800">
                <span class="text-[10px] text-slate-400 block">Gewicht</span>
                <span id="gcodeWeightVal" class="text-sm font-extrabold text-emerald-400 font-mono-num">0 g</span>
              </div>
              <div class="p-2 rounded-lg bg-slate-900 border border-slate-800">
                <span class="text-[10px] text-slate-400 block">Druckzeit</span>
                <span id="gcodeTimeVal" class="text-sm font-extrabold text-sky-400 font-mono-num">0h 0m</span>
              </div>
              <div class="p-2 rounded-lg bg-slate-900 border border-slate-800">
                <span class="text-[10px] text-slate-400 block">Material</span>
                <span id="gcodeMatVal" class="text-sm font-extrabold text-orange-400">PLA</span>
              </div>
            </div>

            <div class="space-y-1.5">
              <label class="block text-[11px] font-bold text-orange-400">👇 Klicke auf das verwendete Filament zum Abziehen:</label>
              <div id="gcodeSpoolSelectList" class="space-y-1.5 max-h-60 overflow-y-auto pr-1"></div>
            </div>
          </div>
        </div>

        <!-- TAB 3: DRUCK-KOSTENRECHNER -->
        <div id="sidebarTab-calc" class="space-y-3 hidden">
          <div class="rounded-xl bg-slate-950 border border-amber-500/30 p-3.5 space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-amber-400 uppercase flex items-center gap-1.5">
                <i data-lucide="calculator" class="w-4 h-4"></i>
                <span>Druck-Kostenrechner</span>
              </span>
              <label class="text-[11px] text-sky-400 hover:underline cursor-pointer font-semibold">
                📄 Aus G-Code laden
                <input type="file" accept=".gcode,.gco,.txt" onchange="handleGcodeUpload(event, true)" class="hidden" />
              </label>
            </div>

            <div class="space-y-2.5 text-xs">
              <div>
                <label class="block text-[11px] text-slate-400 mb-1">Spule auswählen (für exakten €/kg Preis)</label>
                <select id="calcSpoolSelect" onchange="onCalcSpoolChange()" class="w-full px-2.5 py-2 rounded-lg bg-slate-900 border border-slate-700 text-xs text-white outline-none"></select>
              </div>

              <div class="grid grid-cols-2 gap-2.5">
                <div>
                  <label class="block text-[11px] text-slate-400 mb-1">Modellgewicht (g)</label>
                  <input id="calcWeightGrams" type="number" value="85" oninput="runCostCalculation()" class="w-full px-2.5 py-1.5 rounded-lg bg-slate-900 border border-slate-700 font-mono-num text-white outline-none" />
                </div>
                <div>
                  <label class="block text-[11px] text-slate-400 mb-1">Filamentpreis (€/kg)</label>
                  <input id="calcPricePerKg" type="number" step="0.5" value="21.99" oninput="runCostCalculation()" class="w-full px-2.5 py-1.5 rounded-lg bg-slate-900 border border-slate-700 font-mono-num text-white outline-none" />
                </div>
                <div>
                  <label class="block text-[11px] text-slate-400 mb-1">Druckdauer (Stunden)</label>
                  <input id="calcPrintHours" type="number" step="0.25" value="3.5" oninput="runCostCalculation()" class="w-full px-2.5 py-1.5 rounded-lg bg-slate-900 border border-slate-700 font-mono-num text-white outline-none" />
                </div>
                <div>
                  <label class="block text-[11px] text-slate-400 mb-1">Drucker-Verbrauch (W)</label>
                  <input id="calcPrinterWatts" type="number" value="150" oninput="runCostCalculation()" class="w-full px-2.5 py-1.5 rounded-lg bg-slate-900 border border-slate-700 font-mono-num text-white outline-none" />
                </div>
                <div>
                  <label class="block text-[11px] text-slate-400 mb-1">Strompreis (€/kWh)</label>
                  <input id="calcKwhPrice" type="number" step="0.01" value="0.35" oninput="runCostCalculation()" class="w-full px-2.5 py-1.5 rounded-lg bg-slate-900 border border-slate-700 font-mono-num text-white outline-none" />
                </div>
                <div>
                  <label class="block text-[11px] text-slate-400 mb-1">Verschleiß / Puffer (€)</label>
                  <input id="calcWearEuro" type="number" step="0.05" value="0.30" oninput="runCostCalculation()" class="w-full px-2.5 py-1.5 rounded-lg bg-slate-900 border border-slate-700 font-mono-num text-white outline-none" />
                </div>
              </div>

              <!-- Ergebnis-Aufschlüsselung -->
              <div class="rounded-xl bg-slate-900 border border-slate-800 p-3 space-y-1.5 mt-2">
                <div class="flex justify-between text-slate-400">
                  <span>Materialkosten:</span>
                  <span id="resMatCost" class="font-mono-num text-white font-semibold">1,87 €</span>
                </div>
                <div class="flex justify-between text-slate-400">
                  <span>Stromkosten:</span>
                  <span id="resElecCost" class="font-mono-num text-white font-semibold">0,18 €</span>
                </div>
                <div class="flex justify-between text-slate-400">
                  <span>Verschleiß & Puffer:</span>
                  <span id="resWearCost" class="font-mono-num text-white font-semibold">0,30 €</span>
                </div>
                <div class="flex justify-between text-sm font-extrabold border-t border-slate-800 pt-2 text-emerald-400">
                  <span>Gesamtkosten Druck:</span>
                  <span id="resTotalCost" class="font-mono-num">2,35 €</span>
                </div>
              </div>

              <button onclick="deductFromCostCalculator()" class="w-full py-2 rounded-xl bg-orange-500 hover:bg-orange-600 text-white font-bold text-xs transition">
                Gewicht jetzt von gewählter Spule abziehen
              </button>
            </div>
          </div>
        </div>

        <!-- TAB 4: WERKZEUGE, CLOUD-SYNC & SCHNELLVERSAND-SHOPS -->
        <div id="sidebarTab-tools" class="space-y-3 hidden">
          <div class="space-y-1.5">
            <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400">Schnell-Aktionen</label>
            <button onclick="openSpoolModal(); closeSideMenu();" class="w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl bg-orange-500/15 hover:bg-orange-500/25 text-orange-400 border border-orange-500/30 text-xs font-bold transition">
              <i data-lucide="plus-circle" class="w-4 h-4"></i>
              <span>Neue Spule eintragen</span>
            </button>
            <button onclick="openQrModal(); closeSideMenu();" class="w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold transition">
              <i data-lucide="qr-code" class="w-4 h-4 text-orange-400"></i>
              <span>QR-Code & Handy-Kopplung</span>
            </button>
            <button onclick="loadStateFromCloud(true); closeSideMenu();" class="w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold transition">
              <i data-lucide="refresh-cw" class="w-4 h-4 text-emerald-400"></i>
              <span>Jetzt mit npoint.io Cloud synchronisieren</span>
            </button>
            <button onclick="exportData(); closeSideMenu();" class="w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold transition">
              <i data-lucide="download" class="w-4 h-4 text-sky-400"></i>
              <span>Backup-Datei herunterladen (.json)</span>
            </button>
            <label class="w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold transition cursor-pointer">
              <i data-lucide="upload" class="w-4 h-4 text-amber-400"></i>
              <span>Backup / JSON-Datei importieren</span>
              <input type="file" accept=".json,application/json" onchange="importData(event)" class="hidden" />
            </label>
            <button onclick="loadPreset21Spools(); closeSideMenu();" class="w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl bg-emerald-500/15 hover:bg-emerald-500/25 text-emerald-300 border border-emerald-500/30 text-xs font-bold transition">
              <i data-lucide="database" class="w-4 h-4 text-emerald-400"></i>
              <span>Meine 21 diktierten Spulen wiederherstellen</span>
            </button>
          </div>

          <!-- Zuverlässige Shops mit 1-3 Tagen Lieferzeit -->
          <div class="rounded-xl bg-slate-950 border border-slate-800 p-3 space-y-2 text-xs">
            <span class="font-bold text-slate-300 block">🚚 Zuverlässige Shops (1–3 Tage Versand DE)</span>
            <p class="text-[11px] text-slate-400">Bambu Lab & SUNLU führen direkt zum offiziellen Hersteller-Shop, alle anderen Marken direkt zu Amazon.de Prime:</p>
            <div class="space-y-1 text-[11px]">
              <a href="https://eu.store.bambulab.com/de/collections/bambu-lab-3d-printer-filament" target="_blank" rel="noopener" class="flex justify-between p-2 rounded-lg bg-slate-900 hover:bg-slate-800 text-slate-200">
                <span>🟢 Bambu Lab EU-Store (DE-Lager)</span>
                <span class="text-emerald-400 font-mono-num">ab 17,99 €/kg</span>
              </a>
              <a href="https://www.sunlu.com/collections/fdm-printer-filament" target="_blank" rel="noopener" class="flex justify-between p-2 rounded-lg bg-slate-900 hover:bg-slate-800 text-slate-200">
                <span>🟢 SUNLU Official Store (EU-Versand)</span>
                <span class="text-emerald-400 font-mono-num">ab 13,99 €/kg</span>
              </a>
              <a href="https://www.amazon.de/s?k=3d+filament+1.75mm" target="_blank" rel="noopener" class="flex justify-between p-2 rounded-lg bg-slate-900 hover:bg-slate-800 text-slate-200">
                <span>🟢 Amazon.de Prime (1–2 Tage)</span>
                <span class="text-emerald-400 font-mono-num">ab 15,99 €/kg</span>
              </a>
            </div>
          </div>
        </div>

      </div>

      <!-- Drawer Footer -->
      <div class="p-3.5 border-t border-slate-800 bg-slate-950/80 text-[11px] text-slate-400 flex items-center justify-between">
        <span>👉 Klick rechts schließt das Menü</span>
        <span class="font-mono-num text-orange-400 font-bold">v1.21</span>
      </div>
    </aside>
  </div>

  <!-- ========================================================================= -->
  <!-- TOP NAVBAR                                                                -->
  <!-- ========================================================================= -->
  <header class="sticky top-0 z-30 backdrop-blur-xl bg-slate-900/85 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <button
          onclick="openSideMenu()"
          title="Seitenmenü öffnen (KI-Agent, G-Code, Rechner)"
          class="inline-flex items-center gap-2 px-3 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-100 border border-slate-700 transition shadow"
        >
          <i data-lucide="menu" class="w-5 h-5 text-orange-400"></i>
          <span class="text-xs font-bold hidden sm:inline">Menü & KI</span>
        </button>

        <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-orange-500 to-amber-600 flex items-center justify-center shadow-lg shadow-orange-500/20">
          <i data-lucide="disc-3" class="w-5 h-5 text-white"></i>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-lg sm:text-xl font-extrabold tracking-tight text-white">FilamentHub</h1>
            <span class="text-[11px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-full bg-orange-500/15 text-orange-400 border border-orange-500/30 font-mono-num">v1.21</span>
          </div>
          <p class="text-[11px] text-slate-400 hidden md:block">Waagen-Tara, Trocknungsbalken, G-Code, Kostenrechner & Live-Cloud</p>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <!-- Ansichts-Umschalter direkt in der Kopfzeile -->
        <div class="inline-flex items-center rounded-xl bg-slate-950 border border-slate-800 p-0.5" title="Zwischen vollständiger Ansicht (mit Trocknungsbalken) und vereinfachter Ansicht wechseln">
          <button id="topBtnFull" onclick="setViewMode('full')" class="px-2.5 py-1.5 rounded-lg text-xs font-bold transition">
            Vollständig
          </button>
          <button id="topBtnSimple" onclick="setViewMode('simple')" class="px-2.5 py-1.5 rounded-lg text-xs font-bold transition">
            Vereinfacht
          </button>
        </div>

        <div class="inline-flex items-center rounded-xl border border-slate-700 overflow-hidden">
          <button id="undoBtn" onclick="undoAction()" title="Rückgängig (Strg+Z)" class="inline-flex items-center gap-1.5 px-2.5 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold transition disabled:opacity-40 disabled:cursor-not-allowed">
            <i data-lucide="undo-2" class="w-3.5 h-3.5 text-sky-400"></i>
            <span class="hidden lg:inline">Rückgängig</span>
          </button>
          <button id="redoBtn" onclick="redoAction()" title="Vorwärts (Strg+Y)" class="inline-flex items-center gap-1.5 px-2.5 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold border-l border-slate-700 transition disabled:opacity-40 disabled:cursor-not-allowed">
            <i data-lucide="redo-2" class="w-3.5 h-3.5 text-sky-400"></i>
            <span class="hidden lg:inline">Vorwärts</span>
          </button>
        </div>

        <button onclick="openQrModal()" title="QR-Code zum Koppeln auf dem Handy" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold border border-slate-700 transition">
          <i data-lucide="qr-code" class="w-3.5 h-3.5 text-orange-400"></i>
          <span class="hidden sm:inline">QR-Code</span>
        </button>

        <button onclick="loadStateFromCloud(true)" title="Jetzt mit Cloud synchronisieren" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold border border-slate-700 transition">
          <i data-lucide="refresh-cw" class="w-3.5 h-3.5 text-emerald-400"></i>
          <span class="hidden sm:inline">Sync</span>
        </button>

        <button onclick="openHistoryModal()" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold border border-slate-700 transition">
          <i data-lucide="history" class="w-4 h-4 text-orange-400"></i>
          <span class="hidden sm:inline">Verlauf</span>
          <span id="historyBadge" class="px-1.5 py-0.5 text-[10px] rounded-full bg-slate-700 text-slate-300">0</span>
        </button>

        <button onclick="openSpoolModal()" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-gradient-to-r from-orange-500 to-amber-500 hover:from-orange-600 hover:to-amber-600 text-white text-xs sm:text-sm font-bold shadow-lg shadow-orange-500/25 transition">
          <i data-lucide="plus-circle" class="w-4 h-4"></i>
          <span>Neue Spule</span>
        </button>
      </div>
    </div>
  </header>

  <!-- ========================================================================= -->
  <!-- HAUPTBEREICH                                                              -->
  <!-- ========================================================================= -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

    <!-- KPI KACHELN -->
    <section class="grid grid-cols-2 lg:grid-cols-5 gap-3.5">
      <div class="rounded-2xl bg-slate-900/90 border border-slate-800 p-4">
        <span class="text-[11px] text-slate-400 font-semibold">Spulen im Bestand</span>
        <div id="statTotalSpools" class="text-xl sm:text-2xl font-extrabold text-white font-mono-num mt-0.5">0</div>
      </div>
      <div class="rounded-2xl bg-slate-900/90 border border-slate-800 p-4">
        <span class="text-[11px] text-slate-400 font-semibold">Netto-Filament</span>
        <div id="statTotalWeight" class="text-xl sm:text-2xl font-extrabold text-emerald-400 font-mono-num mt-0.5">0 g</div>
      </div>
      <div class="rounded-2xl bg-slate-900/90 border border-slate-800 p-4">
        <span class="text-[11px] text-slate-400 font-semibold">Bestandswert (ca.)</span>
        <div id="statTotalValue" class="text-xl sm:text-2xl font-extrabold text-sky-400 font-mono-num mt-0.5">0,00 €</div>
      </div>
      <div class="rounded-2xl bg-slate-900/90 border border-slate-800 p-4">
        <span class="text-[11px] text-slate-400 font-semibold">Trocknung fällig / bald</span>
        <div id="statDryingDue" class="text-xl sm:text-2xl font-extrabold text-rose-400 font-mono-num mt-0.5">0</div>
      </div>
      <div class="col-span-2 lg:col-span-1 rounded-2xl bg-slate-900/90 border border-slate-800 p-4">
        <span class="text-[11px] text-slate-400 font-semibold">Verdruckt (Verlauf)</span>
        <div id="statUsedWeight" class="text-xl sm:text-2xl font-extrabold text-orange-400 font-mono-num mt-0.5">0 g</div>
      </div>
    </section>

    <!-- SCHNELL-SCANNER FÜR PRODUKT-LINKS & DIREKT-EINGABE (in vollständiger Ansicht) -->
    <section id="quickScannerSection" class="rounded-2xl bg-gradient-to-r from-slate-900 via-slate-850 to-slate-900 border border-orange-500/30 p-4 shadow-xl">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3">
        <div>
          <div class="inline-flex items-center gap-1.5 text-orange-400 text-xs font-bold uppercase tracking-wider">
            <i data-lucide="wand-2" class="w-3.5 h-3.5"></i>
            <span>Intelligenter Produkt-Link & Namen-Scanner</span>
          </div>
          <p class="text-xs text-slate-400 mt-0.5">Link (Amazon, Bambu Lab, SUNLU, 3DJake) oder Namen (z.B. „Bambu PLA Matte Schwarz“) einfügen – prüft erst im Formular, bevor gespeichert wird!</p>
        </div>
        <div class="flex-1 max-w-xl flex flex-col sm:flex-row gap-2">
          <input id="quickLinkInput" type="text" placeholder="Link oder Filamentname (z.B. SUNLU PETG Weiß)..." onkeydown="if(event.key==='Enter'){handleQuickLinkImport();}" class="flex-1 px-3.5 py-2 rounded-xl bg-slate-950 border border-slate-700 focus:border-orange-500 text-xs text-white outline-none" />
          <button id="quickScanBtn" onclick="handleQuickLinkImport()" class="px-4 py-2 rounded-xl bg-orange-500 hover:bg-orange-600 text-white text-xs font-bold whitespace-nowrap transition">
            Auslesen & Prüfen
          </button>
        </div>
      </div>
    </section>

    <!-- FILTER & SORTIER-LEISTE -->
    <section class="rounded-2xl bg-slate-900/90 border border-slate-800 p-4 space-y-3">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
        <div id="materialFilterBar" class="flex items-center gap-1.5 overflow-x-auto pb-1"></div>
        <div class="flex flex-wrap items-center gap-2">
          <input id="searchInput" type="text" oninput="renderSpools()" placeholder="Suche nach Marke, Farbe, Material, Beutel..." class="w-full sm:w-56 px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 focus:border-orange-500 text-xs text-white outline-none" />
          <select id="sortSelect" onchange="renderSpools()" class="px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs font-semibold text-slate-200 outline-none">
            <option value="drying_urgent">🔥 Trocknung (dringend zuerst)</option>
            <option value="drying_fresh">✨ Frisch getrocknet zuerst</option>
            <option value="remaining_asc">⚖️ Restgewicht (wenig zuerst)</option>
            <option value="remaining_desc">⚖️ Restgewicht (viel zuerst)</option>
            <option value="price_asc">💶 Preis €/kg (günstigste zuerst)</option>
            <option value="brand_asc">🏷️ Hersteller (A–Z)</option>
            <option value="material_asc">🧪 Material (A–Z)</option>
            <option value="color_asc">🎨 Farbe (A–Z)</option>
          </select>
        </div>
      </div>

      <!-- Schnell-Sortier-Buttons -->
      <div class="flex flex-wrap items-center gap-1.5 pt-2 border-t border-slate-800/80 text-[11px]">
        <span class="text-slate-500 font-semibold mr-1">Schnellsortierung:</span>
        <button onclick="setQuickSort('drying_urgent')" class="px-2.5 py-1 rounded-lg bg-slate-950 hover:bg-slate-800 text-slate-300 border border-slate-800 transition">🔥 Trocknung fällig</button>
        <button onclick="setQuickSort('remaining_asc')" class="px-2.5 py-1 rounded-lg bg-slate-950 hover:bg-slate-800 text-slate-300 border border-slate-800 transition">⚖️ Wenig Gewicht zuerst</button>
        <button onclick="setQuickSort('remaining_desc')" class="px-2.5 py-1 rounded-lg bg-slate-950 hover:bg-slate-800 text-slate-300 border border-slate-800 transition">⚖️ Viel Gewicht zuerst</button>
        <button onclick="setQuickSort('price_asc')" class="px-2.5 py-1 rounded-lg bg-slate-950 hover:bg-slate-800 text-slate-300 border border-slate-800 transition">💶 Günstigste zuerst</button>
        <button onclick="setQuickSort('brand_asc')" class="px-2.5 py-1 rounded-lg bg-slate-950 hover:bg-slate-800 text-slate-300 border border-slate-800 transition">🏷️ Nach Hersteller</button>
        <button onclick="setQuickSort('color_asc')" class="px-2.5 py-1 rounded-lg bg-slate-950 hover:bg-slate-800 text-slate-300 border border-slate-800 transition">🎨 Nach Farbe</button>
      </div>
    </section>

    <!-- SPULEN RASTER -->
    <section id="spoolGrid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5"></section>
  </main>

  <!-- ========================================================================= -->
  <!-- MODAL: SPULE HINZUFÜGEN / BEARBEITEN                                      -->
  <!-- ========================================================================= -->
  <div id="spoolModal" onclick="if(event.target === this) closeSpoolModal()" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/80 backdrop-blur-sm p-4 overflow-y-auto">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-xl w-full p-6 space-y-4 shadow-2xl my-8 max-h-[92vh] overflow-y-auto">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <div>
          <h3 id="modalTitle" class="text-lg font-bold text-white">Spule eintragen</h3>
          <p id="modalSubTitle" class="text-xs text-slate-400">Wird erst gespeichert, wenn du unten auf „Spule speichern“ klickst</p>
        </div>
        <button onclick="closeSpoolModal()" class="p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800">✕</button>
      </div>

      <!-- Produkt-Link Scanner im Modal -->
      <div class="rounded-xl bg-slate-950/90 border border-orange-500/30 p-3 space-y-2">
        <div class="flex items-center justify-between">
          <label class="block text-xs font-bold text-orange-400 uppercase">Shop-Link (Bambu Lab & SUNLU = Hersteller-Shop, Rest = Amazon.de)</label>
          <a id="modalTestLinkBtn" href="#" target="_blank" rel="noopener" class="text-[11px] text-sky-400 hover:underline font-semibold">Link testen ↗</a>
        </div>
        <div class="flex gap-2">
          <input id="fProductUrl" type="url" placeholder="Leer lassen = Auto-Link passend zur Marke" class="flex-1 px-3 py-2 rounded-lg bg-slate-900 border border-slate-700 text-xs text-white outline-none" />
          <button id="modalScanBtn" type="button" onclick="fetchFromModalUrl()" class="px-3.5 py-2 rounded-lg bg-orange-500 hover:bg-orange-600 text-white text-xs font-bold whitespace-nowrap">Auslesen</button>
        </div>
        <p id="modalDetectedInfo" class="text-[11px] text-emerald-400 hidden"></p>
      </div>

      <form id="spoolForm" onsubmit="saveSpool(event)" class="space-y-3.5">
        <input type="hidden" id="fId" />

        <!-- Hersteller & Bezeichnung -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Hersteller / Marke *</label>
            <select id="fBrandSelect" onchange="handleBrandDropdownChange()" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white outline-none">
              <option value="Bambu Lab">Bambu Lab</option>
              <option value="SUNLU">SUNLU</option>
              <option value="ELEGOO">ELEGOO</option>
              <option value="Prusament">Prusament</option>
              <option value="Eryone">Eryone</option>
              <option value="Polymaker">Polymaker</option>
              <option value="Overture">Overture</option>
              <option value="Eono">Eono</option>
              <option value="eSUN">eSUN</option>
              <option value="Extrudr">Extrudr</option>
              <option value="Geeetech">Geeetech</option>
              <option value="Isan">Isan</option>
              <option value="Anycubic">Anycubic</option>
              <option value="Creality">Creality</option>
              <option value="3DJake">3DJake</option>
              <option value="No-Name (China)">No-Name (China)</option>
              <option value="OTHER">➕ Anderer Hersteller...</option>
            </select>
            <input id="fBrandCustom" type="text" placeholder="Hersteller eingeben..." class="w-full mt-2 px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white outline-none hidden" />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Bezeichnung / Serie *</label>
            <input id="fName" type="text" required placeholder="z.B. PLA Basic Dunkelgrün" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white outline-none" />
          </div>
        </div>

        <!-- Material, Farbe & Preis -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Material *</label>
            <select id="fMaterial" onchange="applyMaterialPresetInModal()" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white outline-none">
              <option value="PLA">PLA</option>
              <option value="PLA+">PLA+</option>
              <option value="PETG">PETG</option>
              <option value="TPU">TPU (Flex)</option>
              <option value="ABS">ABS</option>
              <option value="ASA">ASA</option>
              <option value="PA / Nylon">PA / Nylon</option>
              <option value="PC">PC (Polycarbonat)</option>
              <option value="PET-CF / PA-CF">Carbon Fiber (CF)</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Farbe & Vorschau *</label>
            <div class="flex items-center gap-1.5">
              <input id="fColorHex" type="color" value="#f97316" class="w-9 h-9 rounded-xl bg-slate-950 border border-slate-800 p-1 cursor-pointer shrink-0" />
              <input id="fColorName" type="text" required placeholder="z.B. Marmor" oninput="autoMatchHexFromColorInput(this.value)" class="w-full px-2.5 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white outline-none" />
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Preis (€ pro kg)</label>
            <input id="fPricePerKg" type="number" step="0.01" value="19.99" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs font-mono-num text-emerald-400 font-bold outline-none" />
          </div>
        </div>

        <!-- Gewicht & Waage im Modal -->
        <div class="rounded-xl bg-slate-950/80 border border-emerald-500/30 p-3 space-y-2.5">
          <div class="grid grid-cols-3 gap-2.5">
            <div>
              <label class="block text-[11px] text-slate-400 mb-1">Startgewicht (g)</label>
              <input id="fInitialWeight" type="number" value="1000" class="w-full px-2.5 py-2 rounded-lg bg-slate-900 border border-slate-700 text-xs font-mono-num text-white outline-none" />
            </div>
            <div>
              <label class="block text-[11px] text-slate-400 mb-1">Restgewicht Netto (g)</label>
              <input id="fRemainingWeight" type="number" value="1000" class="w-full px-2.5 py-2 rounded-lg bg-slate-900 border border-slate-700 text-xs font-mono-num text-emerald-400 font-bold outline-none" />
            </div>
            <div>
              <label class="block text-[11px] text-slate-400 mb-1">Leerspule Tara (g)</label>
              <input id="fEmptySpoolWeight" type="number" value="250" oninput="applyModalScale()" class="w-full px-2.5 py-2 rounded-lg bg-slate-900 border border-slate-700 text-xs font-mono-num text-white outline-none" />
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
            <div>
              <label class="block text-[11px] text-emerald-400 font-semibold mb-1">⚖️ Komplettgewicht auf Waage (g)</label>
              <input id="fScaleGross" type="number" oninput="applyModalScale()" placeholder="Spule + Filament in g..." class="w-full px-2.5 py-1.5 rounded-lg bg-slate-900 border border-slate-700 text-xs font-mono-num text-white outline-none" />
            </div>
            <div>
              <label class="block text-[11px] text-slate-400 mb-1">Lagerung / Notiz (z.B. Eibos Beutel)</label>
              <input id="fStorageNote" type="text" placeholder="z.B. Im Eibos Vakuumbeutel" class="w-full px-2.5 py-1.5 rounded-lg bg-slate-900 border border-slate-700 text-xs text-white outline-none" />
            </div>
          </div>
          <p id="fScaleHint" class="text-[11px] text-slate-400">Leerspule wird automatisch abgezogen.</p>
        </div>

        <!-- Trocknungs-Einstellungen -->
        <div class="rounded-xl bg-slate-950/80 border border-slate-800 p-3 space-y-2.5">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-slate-300 flex items-center gap-1.5">
              <i data-lucide="flame" class="w-4 h-4 text-amber-400"></i>
              <span>Trocknungsprozess & Intervall</span>
            </span>
            <button type="button" onclick="setModalDriedNow()" class="text-[11px] text-orange-400 hover:underline font-semibold">
              Auf „Jetzt getrocknet“ setzen
            </button>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-4 gap-2.5">
            <div class="sm:col-span-2">
              <label class="block text-[11px] text-slate-400 mb-1">Zuletzt getrocknet</label>
              <input id="fLastDried" type="datetime-local" class="w-full px-2.5 py-2 rounded-lg bg-slate-900 border border-slate-700 text-xs text-white outline-none" />
            </div>
            <div>
              <label class="block text-[11px] text-slate-400 mb-1">Intervall (Tage)</label>
              <input id="fDryIntervalDays" type="number" min="1" max="365" value="30" class="w-full px-2.5 py-2 rounded-lg bg-slate-900 border border-slate-700 text-sm font-mono-num text-white outline-none" />
            </div>
            <div>
              <label class="block text-[11px] text-slate-400 mb-1">Temp °C / Dauer h</label>
              <div class="flex gap-1">
                <input id="fDryTemp" type="number" value="50" class="w-1/2 px-2 py-2 rounded-lg bg-slate-900 border border-slate-700 text-xs font-mono-num text-white outline-none" title="°C" />
                <input id="fDryHours" type="number" value="5" class="w-1/2 px-2 py-2 rounded-lg bg-slate-900 border border-slate-700 text-xs font-mono-num text-white outline-none" title="Stunden" />
              </div>
            </div>
          </div>
        </div>

        <div class="flex justify-end gap-2 pt-2">
          <button type="button" onclick="closeSpoolModal()" class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-300">Abbrechen</button>
          <button type="submit" class="px-5 py-2.5 rounded-xl bg-orange-500 hover:bg-orange-600 text-xs font-bold text-white shadow-lg shadow-orange-500/20">Spule speichern</button>
        </div>
      </form>
    </div>
  </div>

