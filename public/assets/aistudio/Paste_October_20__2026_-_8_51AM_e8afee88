    function runQuickPrompt(text) {
      document.getElementById('aiPromptInput').value = text;
      handleAiPrompt();
    }

    function handleAiPrompt() {
      const input = document.getElementById('aiPromptInput');
      const prompt = (input.value || '').trim();
      if (!prompt) return;
      input.value = '';
      appendAiMessage(prompt, true);

      const lower = prompt.toLowerCase();

      // 1. Ansichtsmodus per KI umschalten
      if (lower.includes('vereinfacht') || lower.includes('simpel') || lower.includes('kompakt')) {
        setViewMode('simple');
        appendAiMessage('✅ Ich habe auf die <strong>vereinfachte Ansicht</strong> (ohne Trocknungsbalken) umgeschaltet.');
        return;
      }
      if (lower.includes('vollständig') || lower.includes('trocknungsbalken')) {
        setViewMode('full');
        appendAiMessage('✅ Ich habe auf die <strong>vollständige Ansicht</strong> (inklusive Trocknungsbalken) umgeschaltet.');
        return;
      }

      // 2. Trocknungs-Check
      if (lower.includes('trocknen') || lower.includes('trocknung') || lower.includes('fällig')) {
        if (lower.includes('markiere') || lower.includes('getrocknet')) {
          const matched = spools.filter(s => lower.includes(s.brand.toLowerCase()) || lower.includes(s.name.toLowerCase()) || lower.includes(s.colorName.toLowerCase()));
          if (matched.length > 0) {
            pushUndo();
            matched.forEach(s => { s.lastDried = new Date().toISOString(); });
            saveState();
            appendAiMessage(`🔥 Ich habe <strong>${matched.length} Spule(n)</strong> (${matched.map(m => `${m.brand} ${m.name}`).join(', ')}) als <strong>jetzt getrocknet</strong> markiert!`);
            return;
          }
        }
        const overdue = spools.filter(s => getDryingStatus(s).statusLevel !== 'ok');
        if (!overdue.length) {
          appendAiMessage('✨ Alle deine Spulen sind aktuell trocken und im grünen Bereich!');
        } else {
          appendAiMessage(`⚠️ Aktuell sollten <strong>${overdue.length} Spulen</strong> getrocknet werden:<br>• ` + overdue.map(s => `<strong>${s.brand} ${s.name}</strong> (${s.remainingWeight}g)`).join('<br>• '));
        }
        return;
      }

      // 3. Gewicht abziehen per Befehl (z.B. "Zieh 45g von Bambu Dunkelgrün ab")
      const gramMatch = prompt.match(/(\d+)\s*(?:g|gramm)/i);
      if ((lower.includes('zieh') || lower.includes('abziehen') || lower.includes('verdruckt') || lower.includes('minus')) && gramMatch) {
        const grams = parseInt(gramMatch[1]);
        const target = spools.find(s =>
          lower.includes(s.name.toLowerCase()) ||
          (lower.includes(s.brand.toLowerCase()) && lower.includes((s.colorName || '').toLowerCase())) ||
          lower.includes((s.colorName || '').toLowerCase())
        );
        if (target) {
          deductWeight(target.id, grams);
          appendAiMessage(`✅ <strong>${grams} g</strong> wurden von <strong>${target.brand} ${target.name}</strong> abgezogen (neu: <strong>${target.remainingWeight} g</strong>).`);
          return;
        }
      }

      // 4. Neue Spule per KI eintragen
      if (lower.includes('trag') || lower.includes('füg') || lower.includes('neu')) {
        const parsed = parseFilamentText(prompt, prompt);
        if (gramMatch) parsed.remainingWeight = parseInt(gramMatch[1]);
        openSpoolModal(null, parsed);
        appendAiMessage(`🪄 Ich habe <strong>${parsed.brand} ${parsed.name}</strong> vorbereitet und das Prüf-Fenster geöffnet. Klicke dort auf „Spule speichern“!`);
        return;
      }

      // 5. Bestands- und Wert-Report
      const totalG = spools.reduce((acc, s) => acc + (Number(s.remainingWeight) || 0), 0);
      const val = document.getElementById('statTotalValue').textContent;
      appendAiMessage(`📊 Du hast aktuell <strong>${spools.length} Spulen</strong> mit insgesamt <strong>${totalG.toLocaleString('de-DE')} g</strong> Netto-Filament im Wert von ca. <strong>${val}</strong>.`);
    }

    // G-CODE DATEI ANALYSIEREN (Bambu Studio, OrcaSlicer, PrusaSlicer, Cura)
    function handleGcodeUpload(event, openCalculator = false) {
      const file = event.target.files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (e) => {
        const text = e.target.result || '';
        let grams = 0;
        let hours = 1.5;
        let mat = 'PLA';

        // Gewicht in Gramm suchen (verschiedene Slicer-Kommentare)
        const weightPatterns = [
          /total filament used \[g\]\s*=\s*([\d.]+)/i,
          /filament used \[g\]\s*=\s*([\d.]+)/i,
          /; filament used \[g\] = ([\d.,\s]+)/i,
          /filament_weight\s*=\s*([\d.]+)/i,
          /;Weight:([\d.]+)g/i,
          /([\d.]+)\s*g\s*filament/i
        ];
        for (const rx of weightPatterns) {
          const m = text.match(rx);
          if (m) {
            const parts = m[1].split(/[,\s]+/).map(x => parseFloat(x)).filter(x => !isNaN(x));
            grams = Math.round(parts.reduce((a, b) => a + b, 0));
            if (grams > 0) break;
          }
        }
        // Fallback über Meter (1m 1.75mm PLA ≈ 2.98g)
        if (!grams) {
          const meterMatch = text.match(/;Filament used:\s*([\d.]+)m/i) || text.match(/filament used \[mm\]\s*=\s*([\d.]+)/i);
          if (meterMatch) {
            const val = parseFloat(meterMatch[1]);
            grams = Math.round(val > 500 ? (val / 1000) * 2.98 : val * 2.98);
          }
        }
        if (!grams) grams = 45; // Sicherheits-Fallback

        // Druckzeit suchen
        const timeMatch = text.match(/estimated printing time.*?=\s*(?:(\d+)d\s*)?(?:(\d+)h\s*)?(?:(\d+)m)?/i) ||
                          text.match(/;TIME:(\d+)/i);
        if (timeMatch) {
          if (timeMatch[0].toUpperCase().startsWith(';TIME:')) {
            hours = Math.round((parseInt(timeMatch[1]) / 3600) * 100) / 100;
          } else {
            const d = parseInt(timeMatch[1] || 0);
            const h = parseInt(timeMatch[2] || 0);
            const m = parseInt(timeMatch[3] || 0);
            hours = Math.max(0.1, Math.round(((d * 24) + h + (m / 60)) * 100) / 100);
          }
        }

        // Material suchen
        const matMatch = text.match(/filament_type\s*=\s*([A-Z0-9+-]+)/i);
        if (matMatch) mat = matMatch[1].toUpperCase();

        lastGcodeAnalysis = { weightGrams: grams, timeHours: hours, material: mat, fileName: file.name };

        // UI im G-Code-Tab aktualisieren
        document.getElementById('gcodeResultBox').classList.remove('hidden');
        document.getElementById('gcodeFileName').textContent = file.name;
        document.getElementById('gcodeWeightVal').textContent = `${grams} g`;
        const hInt = Math.floor(hours);
        const mInt = Math.round((hours - hInt) * 60);
        document.getElementById('gcodeTimeVal').textContent = `${hInt}h ${mInt}m`;
        document.getElementById('gcodeMatVal').textContent = mat;

        // Liste aller vorhandenen Spulen zum 1-Klick-Abzug erzeugen
        const listEl = document.getElementById('gcodeSpoolSelectList');
        listEl.innerHTML = spools.map(s => `
          <button onclick="deductWeight('${s.id}', ${grams}); showToast('${grams}g aus G-Code von ${s.name} abgezogen!');" class="w-full p-2 rounded-lg bg-slate-900 hover:bg-slate-800 border border-slate-800 hover:border-orange-500/50 flex items-center justify-between text-left transition">
            <span class="flex items-center gap-2 min-w-0">
              <span class="w-3.5 h-3.5 rounded-full shrink-0 border border-white/20" style="background-color:${s.colorHex || '#f97316'}"></span>
              <span class="text-xs text-white font-semibold truncate">${s.brand} – ${s.name}</span>
            </span>
            <span class="text-[11px] font-mono-num text-orange-400 font-bold shrink-0">-${grams}g (${s.remainingWeight}g)</span>
          </button>
        `).join('');

        // Werte auch in den Kostenrechner übertragen
        document.getElementById('calcWeightGrams').value = grams;
        document.getElementById('calcPrintHours').value = hours;
        runCostCalculation();

        if (openCalculator) {
          switchSidebarTab('calc');
        } else {
          switchSidebarTab('gcode');
        }
        showToast(`G-Code gelesen: ${grams}g Filament (${hInt}h ${mInt}m)`);
      };
      reader.readAsText(file.slice(0, 250000)); // Liest Header & Footer schnell aus
    }

