    // =========================================================================
    // 8. SPULEN-AKTIONEN: WAAGE, ABZIEHEN, TROCKNEN, KOPIEREN, LÖSCHEN
    // =========================================================================
    function updateScalePreview(id) {
      const spool = spools.find(s => s.id === id);
      const input = document.getElementById(`scale-${id}`);
      const preview = document.getElementById(`scale-preview-${id}`);
      if (!spool || !input || !preview) return;
      const tara = Number(spool.emptySpoolWeight) || 0;
      const gross = parseFloat(input.value);
      if (!input.value || isNaN(gross)) {
        preview.className = 'text-[11px] text-slate-500';
        preview.textContent = `Spule + Filament wiegen → Spule (${tara} g) wird automatisch abgezogen.`;
        return;
      }
      const net = Math.round(gross - tara);
      if (net < 0) {
        preview.className = 'text-[11px] text-rose-400';
        preview.textContent = `⚠️ ${gross} g ist weniger als die Leerspule (${tara} g).`;
      } else {
        preview.className = 'text-[11px] text-emerald-400 font-semibold';
        preview.textContent = `${gross} g (Waage) − ${tara} g (Spule) = ${net} g Netto-Filament`;
      }
    }

    function applyScaleWeight(id) {
      const spool = spools.find(s => s.id === id);
      const input = document.getElementById(`scale-${id}`);
      if (!spool || !input) return;
      const gross = parseFloat(input.value);
      if (isNaN(gross) || gross < 0) return;

      const tara = Number(spool.emptySpoolWeight) || 0;
      if (gross < tara) {
        showToast(`⚠️ ${gross} g ist weniger als die Leerspule (${tara} g).`);
        return;
      }

      pushUndo();
      const newRemaining = Math.round(gross - tara);
      const oldRemaining = Number(spool.remainingWeight) || 0;
      const used = oldRemaining - newRemaining;

      spool.remainingWeight = newRemaining;
      if (used > 0) {
        printHistory.unshift({
          id: 'log-' + Date.now(),
          spoolId: spool.id,
          spoolLabel: `${spool.brand} ${spool.name} (Waage)`,
          grams: used,
          timestamp: new Date().toISOString()
        });
      }
      input.value = '';
      saveState();
      showToast(`Waage: ${gross} g − ${tara} g Spule = ${newRemaining} g Filament.`);
    }

    function deductWeight(id, presetGrams = null) {
      const spool = spools.find(s => s.id === id);
      if (!spool) return;
      const input = document.getElementById(`deduct-${id}`);
      const g = presetGrams !== null ? presetGrams : parseInt(input?.value);
      if (!g || g <= 0) return;

      pushUndo();
      spool.remainingWeight = Math.max(0, (Number(spool.remainingWeight) || 0) - g);
      printHistory.unshift({
        id: 'log-' + Date.now(),
        spoolId: spool.id,
        spoolLabel: `${spool.brand} ${spool.name}`,
        grams: g,
        timestamp: new Date().toISOString()
      });
      if (input && presetGrams === null) input.value = '';
      saveState();
      showToast(`${g}g abgezogen (${spool.remainingWeight}g übrig).`);
    }

    function markDried(id) {
      const spool = spools.find(s => s.id === id);
      if (!spool) return;
      pushUndo();
      spool.lastDried = new Date().toISOString();
      saveState();
      showToast(`${spool.brand} ${spool.name} als getrocknet markiert!`);
    }

    function duplicateSpool(id) {
      const orig = spools.find(s => s.id === id);
      if (!orig) return;
      pushUndo();
      const copy = {
        ...JSON.parse(JSON.stringify(orig)),
        id: 'sp-' + Date.now(),
        name: `${orig.name} (Kopie)`,
        lastDried: new Date().toISOString()
      };
      spools.unshift(copy);
      saveState();
      showToast(`Spule „${orig.brand} ${orig.name}“ wurde kopiert!`);
    }

    function deleteSpool(id) {
      const spool = spools.find(s => s.id === id);
      if (!spool) return;
      pushUndo();
      spools = spools.filter(s => s.id !== id);
      saveState();
      showToast('Spule gelöscht – oben auf „Rückgängig“ tippen zum Wiederherstellen.');
    }

    // =========================================================================
    // 9. MODAL LOGIK (SPULE HINZUFÜGEN & BEARBEITEN)
    // =========================================================================
    function toLocalInputDate(isoStr) {
      const d = isoStr ? new Date(isoStr) : new Date();
      const pad = n => String(n).padStart(2, '0');
      return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
    }

    function setModalDriedNow() {
      document.getElementById('fLastDried').value = toLocalInputDate(new Date().toISOString());
    }

    function applyMaterialPresetInModal() {
      const mat = document.getElementById('fMaterial').value;
      const p = MATERIAL_PRESETS[mat];
      if (p) {
        document.getElementById('fDryIntervalDays').value = p.intervalDays;
        document.getElementById('fDryTemp').value = p.temp;
        document.getElementById('fDryHours').value = p.hours;
      }
      updateModalTestLink();
    }

    function applyModalScale() {
      const grossVal = document.getElementById('fScaleGross').value;
      const hint = document.getElementById('fScaleHint');
      const tara = parseInt(document.getElementById('fEmptySpoolWeight').value) || 0;
      if (grossVal === '' || isNaN(parseFloat(grossVal))) {
        hint.className = 'text-[11px] text-slate-400';
        hint.textContent = `Leerspule: ${tara} g – wird automatisch abgezogen.`;
        return;
      }
      const gross = parseFloat(grossVal);
      const net = Math.round(gross - tara);
      if (net < 0) {
        hint.className = 'text-[11px] text-rose-400';
        hint.textContent = `⚠️ ${gross} g ist weniger als die Leerspule (${tara} g).`;
        return;
      }
      document.getElementById('fRemainingWeight').value = net;
      hint.className = 'text-[11px] text-emerald-400 font-semibold';
      hint.textContent = `${gross} g − ${tara} g Spule = ${net} g Filament → als Restgewicht gesetzt.`;
    }

    function handleBrandDropdownChange() {
      const select = document.getElementById('fBrandSelect');
      const customInput = document.getElementById('fBrandCustom');
      if (select.value === 'OTHER') {
        customInput.classList.remove('hidden');
        customInput.focus();
      } else {
        customInput.classList.add('hidden');
        if (!document.getElementById('fId').value) {
          const b = getBrandInfo(select.value);
          if (b) {
            document.getElementById('fEmptySpoolWeight').value = b.tara;
            document.getElementById('fPricePerKg').value = b.defaultPrice;
            applyModalScale();
          }
        }
      }
      updateModalTestLink();
    }

    function updateModalTestLink() {
      const customUrl = document.getElementById('fProductUrl').value.trim();
      const brand = document.getElementById('fBrandSelect').value === 'OTHER'
        ? document.getElementById('fBrandCustom').value
        : document.getElementById('fBrandSelect').value;
      const mat = document.getElementById('fMaterial').value;
      const name = document.getElementById('fName').value;
      const color = document.getElementById('fColorName').value;
      const url = customUrl || generateAutoShopUrl(brand, mat, name, color);
      const btn = document.getElementById('modalTestLinkBtn');
      if (btn) btn.href = url;
    }

    function populateModalFields(data) {
      if (data.productUrl !== undefined) document.getElementById('fProductUrl').value = data.productUrl || '';
      if (data.name !== undefined) document.getElementById('fName').value = data.name || '';
      if (data.material !== undefined) document.getElementById('fMaterial').value = data.material || 'PLA';
      if (data.colorHex !== undefined) document.getElementById('fColorHex').value = data.colorHex || '#f97316';
      if (data.colorName !== undefined) document.getElementById('fColorName').value = data.colorName || '';
      if (data.pricePerKg !== undefined) document.getElementById('fPricePerKg').value = data.pricePerKg || 19.99;
      if (data.initialWeight !== undefined) document.getElementById('fInitialWeight').value = data.initialWeight;
      if (data.remainingWeight !== undefined) document.getElementById('fRemainingWeight').value = data.remainingWeight;
      if (data.emptySpoolWeight !== undefined) document.getElementById('fEmptySpoolWeight').value = data.emptySpoolWeight;
      if (data.storageNote !== undefined) document.getElementById('fStorageNote').value = data.storageNote || '';
      if (data.dryIntervalDays !== undefined) document.getElementById('fDryIntervalDays').value = data.dryIntervalDays;
      if (data.dryTemp !== undefined) document.getElementById('fDryTemp').value = data.dryTemp;
      if (data.dryHours !== undefined) document.getElementById('fDryHours').value = data.dryHours;
      if (data.lastDried !== undefined) document.getElementById('fLastDried').value = toLocalInputDate(data.lastDried);

      if (data.brand) {
        const select = document.getElementById('fBrandSelect');
        const match = Array.from(select.options).find(o => o.value.toLowerCase() === data.brand.toLowerCase());
        if (match) {
          select.value = match.value;
          document.getElementById('fBrandCustom').classList.add('hidden');
        } else {
          select.value = 'OTHER';
          document.getElementById('fBrandCustom').classList.remove('hidden');
          document.getElementById('fBrandCustom').value = data.brand;
        }
      }
      updateModalTestLink();
    }

    function openSpoolModal(spoolId = null, prefill = null) {
      document.getElementById('modalDetectedInfo').classList.add('hidden');
      document.getElementById('fScaleGross').value = '';

      if (spoolId) {
        const existing = spools.find(s => s.id === spoolId);
        if (!existing) return;
        document.getElementById('modalTitle').textContent = 'Filament-Spule bearbeiten';
        document.getElementById('fId').value = existing.id;
        populateModalFields(existing);
      } else {
        document.getElementById('modalTitle').textContent = prefill ? 'Erkannte Spule prüfen & speichern' : 'Neue Spule eintragen';
        document.getElementById('fId').value = '';
        populateModalFields({
          productUrl: '',
          brand: 'Bambu Lab',
          name: '',
          material: 'PLA',
          colorHex: '#f97316',
          colorName: '',
          pricePerKg: 19.99,
          initialWeight: 1000,
          remainingWeight: 1000,
          emptySpoolWeight: 250,
          storageNote: '',
          dryIntervalDays: 30,
          dryTemp: 50,
          dryHours: 5,
          lastDried: new Date().toISOString(),
          ...(prefill || {})
        });
        if (prefill) {
          const info = document.getElementById('modalDetectedInfo');
          info.textContent = `✓ Automatisch erkannt: ${prefill.brand} • ${prefill.material} • Farbe „${prefill.colorName}“ (Bitte prüfen & unten auf Speichern klicken)`;
          info.classList.remove('hidden');
        }
      }
      applyModalScale();
      document.getElementById('spoolModal').classList.replace('hidden', 'flex');
    }

    function closeSpoolModal() {
      document.getElementById('spoolModal').classList.replace('flex', 'hidden');
    }

    function saveSpool(e) {
      e.preventDefault();
      const existingId = document.getElementById('fId').value;
      const selectVal = document.getElementById('fBrandSelect').value;
      const customVal = document.getElementById('fBrandCustom').value.trim();
      const brand = selectVal === 'OTHER' ? (customVal || 'Unbekannt') : selectVal;
      const mat = document.getElementById('fMaterial').value;
      const preset = MATERIAL_PRESETS[mat] || MATERIAL_PRESETS['PLA'];
      const lastDriedInput = document.getElementById('fLastDried').value;

      const spoolData = {
        id: existingId || ('sp-' + Date.now()),
        brand,
        name: document.getElementById('fName').value.trim(),
        material: mat,
        colorHex: document.getElementById('fColorHex').value,
        colorName: document.getElementById('fColorName').value.trim() || 'Standard',
        pricePerKg: parseFloat(document.getElementById('fPricePerKg').value) || getBrandInfo(brand).defaultPrice || 19.99,
        initialWeight: parseInt(document.getElementById('fInitialWeight').value) || 1000,
        remainingWeight: parseInt(document.getElementById('fRemainingWeight').value) || 0,
        emptySpoolWeight: parseInt(document.getElementById('fEmptySpoolWeight').value) || 0,
        storageNote: document.getElementById('fStorageNote').value.trim(),
        productUrl: document.getElementById('fProductUrl').value.trim(),
        lastDried: lastDriedInput ? new Date(lastDriedInput).toISOString() : new Date().toISOString(),
        dryIntervalDays: parseInt(document.getElementById('fDryIntervalDays').value) || preset.intervalDays,
        dryTemp: parseInt(document.getElementById('fDryTemp').value) || preset.temp,
        dryHours: parseInt(document.getElementById('fDryHours').value) || preset.hours
      };

      pushUndo();
      if (existingId) {
        const index = spools.findIndex(s => s.id === existingId);
        if (index !== -1) spools[index] = spoolData;
        showToast(`Spule „${spoolData.brand} ${spoolData.name}“ aktualisiert!`);
      } else {
        spools.unshift(spoolData);
        showToast(`Neue Spule „${spoolData.brand} ${spoolData.name}“ gespeichert!`);
      }

      saveState();
      closeSpoolModal();
    }

    // =========================================================================
    // 10. DRUCK-VERLAUF, BACKUP EXPORT/IMPORT & URL-EMPFÄNGER
    // =========================================================================
    function openHistoryModal() {
      const list = document.getElementById('historyList');
      list.innerHTML = printHistory.map(h => `
        <div class="p-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs flex justify-between items-center gap-2">
          <div class="min-w-0">
            <p class="font-bold text-white truncate">${h.spoolLabel}</p>
            <p class="text-[10px] text-slate-400">${new Date(h.timestamp).toLocaleString('de-DE')}</p>
          </div>
          <div class="flex items-center gap-2 shrink-0">
            <span class="text-orange-400 font-mono-num font-bold">-${h.grams}g</span>
            <button onclick="undoHistory('${h.id}')" class="px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 text-[10px] text-slate-200">Rückgängig</button>
          </div>
        </div>
      `).join('') || '<p class="text-xs text-slate-500 text-center py-4">Noch keine Druck-Abzüge protokolliert.</p>';
      document.getElementById('historyModal').classList.replace('hidden', 'flex');
    }

    function undoHistory(logId) {
      const idx = printHistory.findIndex(h => h.id === logId);
      if (idx === -1) return;
      const entry = printHistory[idx];
      const spool = spools.find(s => s.id === entry.spoolId);
      pushUndo();
      if (spool) spool.remainingWeight = (Number(spool.remainingWeight) || 0) + (Number(entry.grams) || 0);
      printHistory.splice(idx, 1);
      saveState();
      openHistoryModal();
      showToast(`Abzug von ${entry.grams}g rückgängig gemacht.`);
    }

    function closeHistoryModal() {
      document.getElementById('historyModal').classList.replace('flex', 'hidden');
    }

    function exportData() {
      const blob = new Blob([JSON.stringify({ exportedAt: new Date().toISOString(), spools, printHistory }, null, 2)], { type: 'application/json' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `filamenthub-backup-${new Date().toISOString().slice(0, 10)}.json`;
      a.click();
      showToast('Backup-Datei heruntergeladen.');
    }

    function importData(event) {
      const file = event.target.files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (e) => {
        try {
          const parsed = JSON.parse(e.target.result);
          const importedSpools = Array.isArray(parsed) ? parsed : parsed.spools;
          if (Array.isArray(importedSpools) && importedSpools.length) {
            pushUndo();
            spools = importedSpools.map((s, idx) => ({
              id: s.id || `sp-imp-${Date.now()}-${idx}`,
              brand: s.brand || 'Unbekannt',
              name: s.name || 'Filament',
              material: s.material || 'PLA',
              colorName: s.colorName || s.color || 'Standard',
              colorHex: s.colorHex || '#f97316',
              pricePerKg: Number(s.pricePerKg) || getBrandInfo(s.brand).defaultPrice || 19.99,
              initialWeight: Number(s.initialWeight || s.weight) || 1000,
              remainingWeight: Number(s.remainingWeight ?? s.remaining) || 1000,
              emptySpoolWeight: Number(s.emptySpoolWeight ?? s.tara) || 200,
              storageNote: s.storageNote || s.note || s.storage || '',
              lastDried: s.lastDried || new Date().toISOString(),
              dryIntervalDays: Number(s.dryIntervalDays) || 30,
              dryTemp: Number(s.dryTemp) || 50,
              dryHours: Number(s.dryHours) || 5,
              productUrl: s.productUrl || ''
            }));
            if (Array.isArray(parsed.printHistory)) printHistory = parsed.printHistory;
            saveState();
            showToast(`${spools.length} Spulen erfolgreich importiert!`);
          }
        } catch (err) {
          showToast('Fehler beim Lesen der JSON-Datei.');
        }
      };
      reader.readAsText(file);
    }

    function checkUrlCommands() {
      const params = new URLSearchParams(window.location.search);
      if (params.has('pairCloud')) {
        const paired = params.get('pairCloud');
        if (paired && paired.startsWith('http')) {
          cloudDbUrl = paired;
          localStorage.setItem('filamenthub_cloud_db_url', cloudDbUrl);
          window.history.replaceState({}, '', window.location.pathname);
          showToast('📱 Handy erfolgreich mit der Cloud-Datenbank gekoppelt!');
        }
      }
    }

    function showToast(msg) {
      const c = document.getElementById('toastContainer');
      const t = document.createElement('div');
      t.className = 'px-4 py-2.5 rounded-xl bg-slate-900/95 border border-orange-500/40 text-xs font-semibold text-white shadow-xl backdrop-blur-md';
      t.textContent = msg;
      c.appendChild(t);
      setTimeout(() => t.remove(), 3200);
    }

    // INITIALISIERUNG BEIM START
    window.addEventListener('DOMContentLoaded', () => {
      checkUrlCommands();
      loadLocalBackup();
      updateViewModeUI();
      updateUndoRedoButtons();
      renderSpools();
      loadStateFromCloud(false);

      // GitHub-Felder aus LocalStorage vorbefüllen
      if (localStorage.getItem('fh_gh_owner')) document.getElementById('ghOwner').value = localStorage.getItem('fh_gh_owner');
      if (localStorage.getItem('fh_gh_repo')) document.getElementById('ghRepo').value = localStorage.getItem('fh_gh_repo');
      if (localStorage.getItem('fh_gh_token')) document.getElementById('ghToken').value = localStorage.getItem('fh_gh_token');

      // Automatischer Hintergrund-Sync alle 15 Sekunden + bei Tab-Wechsel
      setInterval(() => { if (!isSyncing && !pendingSync) loadStateFromCloud(false); }, 15000);
      window.addEventListener('focus', () => { if (!isSyncing && !pendingSync) loadStateFromCloud(false); });
    });
  </script>
</body>
