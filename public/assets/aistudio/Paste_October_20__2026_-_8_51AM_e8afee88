    function runCostCalculation() {
      const g = parseFloat(document.getElementById('calcWeightGrams')?.value) || 0;
      const priceKg = parseFloat(document.getElementById('calcPricePerKg')?.value) || 0;
      const hrs = parseFloat(document.getElementById('calcPrintHours')?.value) || 0;
      const watts = parseFloat(document.getElementById('calcPrinterWatts')?.value) || 0;
      const kwhPrice = parseFloat(document.getElementById('calcKwhPrice')?.value) || 0;
      const wear = parseFloat(document.getElementById('calcWearEuro')?.value) || 0;

      const matCost = (g / 1000) * priceKg;
      const elecCost = ((watts / 1000) * hrs) * kwhPrice;
      const total = matCost + elecCost + wear;

      const fmt = n => `${n.toFixed(2).replace('.', ',')} €`;
      document.getElementById('resMatCost').textContent = fmt(matCost);
      document.getElementById('resElecCost').textContent = fmt(elecCost);
      document.getElementById('resWearCost').textContent = fmt(wear);
      document.getElementById('resTotalCost').textContent = fmt(total);
    }

