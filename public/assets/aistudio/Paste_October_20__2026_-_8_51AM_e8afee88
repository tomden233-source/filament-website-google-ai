      try {
        localStorage.setItem(STORAGE_KEY_SPOOLS, JSON.stringify(spools));
        localStorage.setItem(STORAGE_KEY_HISTORY, JSON.stringify(printHistory));
      } catch (e) {}
    }

    function loadLocalBackup() {
      try {
        let raw = localStorage.getItem(STORAGE_KEY_SPOOLS);
        if (!raw) {
          for (const k of LEGACY_KEYS) {
            const legacy = localStorage.getItem(k);
            if (legacy && JSON.parse(legacy)?.length > 0) {
              raw = legacy;
              break;
            }
          }
        }
        if (raw) spools = JSON.parse(raw);
        const h = localStorage.getItem(STORAGE_KEY_HISTORY) || localStorage.getItem('filamenthub_history_v120');
        if (h) printHistory = JSON.parse(h);
      } catch (e) {}

      if (!Array.isArray(spools) || spools.length === 0) {
        spools = JSON.parse(JSON.stringify(DEFAULT_21_SPOOLS));
        saveLocalBackup();
      }
    }

    async function saveState() {
      saveLocalBackup();
      renderSpools();
      if (isSyncing) { pendingSync = true; return; }
      isSyncing = true;
      try {
        do {
          pendingSync = false;
          setSyncStatus('Speichere...', false);
          try {
            const res = await fetch(cloudDbUrl, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ updatedAt: Date.now(), spools, printHistory })
            });
            if (res.ok) setSyncStatus('Cloud synchron', true);
          } catch (e) {
            setSyncStatus('Lokal gespeichert', false);
          }
        } while (pendingSync);
      } finally {
        isSyncing = false;
      }
    }

    async function loadStateFromCloud(manual = false) {
      if (isSyncing) return;
      try {
        isSyncing = true;
        const res = await fetch(cloudDbUrl, { cache: 'no-store' });
        if (res.ok) {
          const data = await res.json();
          if (data && Array.isArray(data.spools) && data.spools.length > 0) {
            spools = data.spools;
            printHistory = Array.isArray(data.printHistory) ? data.printHistory : [];
            saveLocalBackup();
            renderSpools();
            setSyncStatus('Cloud synchron', true);
            if (manual) showToast('Erfolgreich mit Cloud synchronisiert!');
          } else if (spools.length > 0) {
            // Cloud ist noch leer -> lokalen Bestand in die Cloud sichern
            isSyncing = false;
            await saveState();
          }
        }
      } catch (e) {
        setSyncStatus('Lokal aktiv', false);
      } finally {
        isSyncing = false;
      }
    }

